{
  "name": "inrsettle-vnext",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc -b && tsc -p tsconfig.test.json",
    "lint": "eslint .",
    "check:money-columns": "node scripts/check-money-columns.mjs",
    "test": "vitest run",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build -o storybook-static",
    "test:unit": "vitest run --exclude \"**/primitives.test.ts\"",
    "check:source-tree": "node scripts/check-source-tree.mjs",
    "check:requirement-copy": "node scripts/check-requirement-copy.mjs",
    "check:liquidity-copy": "node scripts/check-liquidity-copy.mjs",
    "verify": "pnpm typecheck && pnpm check:source-tree && pnpm lint && pnpm check:money-columns && pnpm check:requirement-copy && pnpm check:liquidity-copy && pnpm check:finality && pnpm check:ops-boundaries && pnpm check:migration-order && pnpm check:styles && pnpm check:motion && pnpm check:alex-test && pnpm check:secrets && pnpm build-storybook && pnpm test",
    "check:finality": "node scripts/check-finality-integrity.mjs",
    "build:api-reference": "UPDATE_API_REFERENCE=1 vitest run apps/api/src/__tests__/reference-doc.test.ts",
    "check:ops-boundaries": "node scripts/check-ops-boundaries.mjs",
    "check:migration-order": "node scripts/check-migration-order.mjs",
    "check:styles": "node scripts/check-styles.mjs",
    "check:motion": "node scripts/check-motion.mjs",
    "check:alex-test": "node scripts/check-alex-test.mjs",
    "check:secrets": "node scripts/check-secrets.mjs"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^8.6.18",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/react": "^8.6.18",
    "@storybook/react-vite": "^8.6.18",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "axe-core": "^4.13.0",
    "eslint": "^9.17.0",
    "jest-axe": "^11.0.0",
    "jsdom": "^30.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "storybook": "^8.6.18",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vite": "^5.4.21",
    "vitest": "^2.1.8"
  }
}
